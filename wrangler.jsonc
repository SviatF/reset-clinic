{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reset-clinic",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "RESET_DATA_R2",
      "bucket_name": "reset-clinic-data"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://resetclinic.org",
    "RESET_REQUIRE_PERSISTENT_STORE": "1"
  }
}
