CLINIC_BOOKING_API_BASE=
CLINIC_BOOKING_API_KEY=

# Lightweight RESET Admin login
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional. If empty, ADMIN_PASSWORD is also used as the session signing secret.
ADMIN_SESSION_SECRET=

# Private Vercel Blob store connected to this project.
# On Vercel, connected stores use OIDC automatically (VERCEL_OIDC_TOKEN + BLOB_STORE_ID).
# BLOB_READ_WRITE_TOKEN is only an optional fallback, e.g. for local development.
BLOB_READ_WRITE_TOKEN=

# Lead security / attribution
LEAD_IP_SALT=

# Encrypt CRM tokens saved from RESET Admin (use a long random value)
INTEGRATIONS_ENCRYPTION_KEY=

# Optional environment-level CRM fallback. Admin-managed CRM config has priority.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Google Search Console + GA4 service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Store PEM as one line with escaped newlines: -----BEGIN...-----\n...\n-----END...-----\n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Example URL-prefix property: https://resetclinic.org/
# Example domain property: sc-domain:resetclinic.org
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Numeric GA4 property ID, not measurement ID G-XXXX
GA4_PROPERTY_ID=

# Optional: force SEO audit to another production/preview origin
SEO_AUDIT_BASE_URL=
